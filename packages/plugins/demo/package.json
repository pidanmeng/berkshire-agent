{
  "name": "@berkshire/plugin-demo",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json && bun scripts/build-client.ts",
    "build:client": "bun scripts/build-client.ts",
    "compile:styles": "bun scripts/compile-styles.ts"
  },
  "dependencies": {
    "@berkshire/cordis": "workspace:*",
    "cordis": "4.0.0-rc.10",
    "zod": "^3.23.8",
    "@berkshire/core": "workspace:*",
    "@berkshire/theme": "workspace:*",
    "@berkshire/ui-slots": "workspace:*",
    "@berkshire/ui": "workspace:*",
    "react": "^19.1.0"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "lightningcss": "^1.33.0"
  }
}