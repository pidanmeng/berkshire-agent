{
  "extends": "../tsconfig.base.json",
  "include": [
    "./**/src/**/*.ts",
    "./**/examples/**/*.ts",
    "./**/test/**/*.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "outDir": "./.out",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@berkshire/cordis": ["./cordis-vendor/src/index.ts"],
      "@berkshire/core": ["./core/src/index.ts"],
      "@berkshire/core/*": ["./core/src/*"],
      "@berkshire/boot": ["./boot/src/index.ts"],
      "@berkshire/sidecar": ["./sidecar/src/index.ts"],
      "@berkshire/theme": ["./theme/src/index.ts"],
      "@berkshire/ui": ["./ui/src/index.ts"],
      "@berkshire/ui-slots": ["./ui-slots/src/index.ts"],
      "@berkshire/plugin-notify-console": ["./plugins/notify-console/src/index.ts"],
      "@berkshire/plugin-demo": ["./plugins/demo/src/index.ts"],
      "@berkshire/plugin-demo/client": ["./plugins/demo/src/client/index.tsx"],
      "@berkshire/base-ui/client": ["./plugins/base-ui/src/client/index.tsx"]
    }
  }
}